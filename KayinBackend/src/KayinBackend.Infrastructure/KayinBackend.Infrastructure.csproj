<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>KayinBackend.Infrastructure</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\KayinBackend.Application\KayinBackend.Application.csproj" />
    <ProjectReference Include="..\KayinBackend.Domain\KayinBackend.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Configuration extensions (IConfiguration.GetValue<T>) -->
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="9.*" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="9.*" />
    <!-- BackgroundService / IHostedService -->
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="9.*" />
    <!-- AddHttpClient<T> extension -->
    <PackageReference Include="Microsoft.Extensions.Http" Version="9.*" />
    <!-- EF Core çekirdeği -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.*" />
    <!-- PostgreSQL sağlayıcısı -->
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="9.*" />
    <!-- SQLite sağlayıcısı (Yerel dev modu için) -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="9.*" />
    <!-- MSSQL sağlayıcısı (isteğe bağlı) -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="9.*" />
    <!-- Migration aracı (design-time) -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.*">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
</Project>
